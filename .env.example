# Vista frontend — environment configuration
# Copy this file to .env.local (gitignored) and adjust as needed.

# Base URL for the FastAPI backend, including the API version prefix.
# Confirmed against the actual backend: default uvicorn port is 8000,
# and app/core/config.py sets API_V1_PREFIX = "/api/v1".
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Do NOT put passwords, tokens, or any credentials in this file or in any
# .env file committed to the repository. Local development user credentials
# (seeded via the backend's scripts_seed_dev_users.py) are entered manually
# at the login screen — they are never read from frontend environment
# variables or embedded in application code.
